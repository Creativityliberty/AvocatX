# Exemple de configuration .env (ne JAMAIS committer vos secrets réels)

# =============================================================================
# SECRETS CRITIQUES - À GÉNÉRER AVANT LE PREMIER DÉMARRAGE
# =============================================================================

# Base de données PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=defenseur_ia
POSTGRES_USER=defenseur
# REQUIRED: Générer un mot de passe fort
# Commande: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Sécurité JWT
# REQUIRED: Générer une clé secrète forte (minimum 32 caractères)
# Commande: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# =============================================================================
# SERVICES EXTERNES - Optionnels mais recommandés
# =============================================================================

# Redis (cache et sessions)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# OpenAI (IA conversationnelle)
# Obtenir une clé sur: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (embeddings alternatifs)
# Obtenir une clé sur: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Pinecone (base vectorielle)
# Obtenir une clé sur: https://app.pinecone.io/
PINECONE_API_KEY=

# Légifrance (données juridiques)
# Obtenir via: https://developer.aife.economie.gouv.fr/
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=

# MongoDB (analytics optionnel)
MONGODB_URI=

# =============================================================================
# CONFIGURATION ENVIRONNEMENT
# =============================================================================

# Environnement: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO

# =============================================================================
# IMPORTANT: SÉCURITÉ
# =============================================================================
# 1. NE JAMAIS committer le fichier .env (déjà dans .gitignore)
# 2. Utiliser des secrets différents pour dev/staging/production
# 3. En production, utiliser un gestionnaire de secrets (AWS Secrets Manager, etc.)
# 4. Rotation régulière des clés API (tous les 90 jours minimum)
# 5. POSTGRES_PASSWORD et SECRET_KEY sont OBLIGATOIRES en production
