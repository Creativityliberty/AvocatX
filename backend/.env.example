# Exemple de configuration .env (ne pas committer vos secrets)

# Base de données PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=defenseur_ia
POSTGRES_USER=defenseur
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Clés API (laisser vide si non utilisées)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
PINECONE_API_KEY=
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=

# MongoDB (optionnel, si utilisé pour l'analytics)
MONGODB_URI=

# Environnement
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_me_in_production
