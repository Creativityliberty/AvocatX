# Variables d'environnement pour Docker Compose
# Copier ce fichier vers .env.docker et renseigner les valeurs

# =============================================================================
# SECRETS POUR DOCKER-COMPOSE
# =============================================================================
# Ces variables sont utilisées par docker-compose.yml pour configurer
# les services PostgreSQL et Backend

# REQUIRED: Mot de passe PostgreSQL
# Générer avec: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# REQUIRED: Clé secrète JWT (minimum 32 caractères)
# Générer avec: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# =============================================================================
# UTILISATION
# =============================================================================
# 1. Copier ce fichier: cp .env.docker.example .env.docker
# 2. Générer les secrets et les ajouter dans .env.docker
# 3. Charger les variables: source .env.docker
# 4. Lancer Docker: docker-compose up -d
#
# Ou en une ligne:
# export $(cat .env.docker | xargs) && docker-compose up -d

# =============================================================================
# SÉCURITÉ
# =============================================================================
# - NE JAMAIS committer .env.docker (déjà dans .gitignore)
# - Utiliser des valeurs différentes entre dev/staging/production
# - Rotation régulière des secrets (90 jours minimum)
